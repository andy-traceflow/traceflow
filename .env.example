# Copy this file to .env for local dev. .env is gitignored — never commit real keys.
# In production (Render), set these in the dashboard's environment tab.

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
ENVIRONMENT=development              # development | staging | production
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
BASE_URL=http://localhost:8000       # public API base; used in webhook URL generation

# ---------------------------------------------------------------------------
# Shopify (webhook source)
# ---------------------------------------------------------------------------
SHOPIFY_WEBHOOK_SECRET=              # REQUIRED — the app refuses to start without it. Shopify admin → Settings → Notifications → Webhooks → "signed with" value at the bottom of the page

# ---------------------------------------------------------------------------
# Destination — exactly one per deployment
# ---------------------------------------------------------------------------
DESTINATION=                         # REQUIRED: monday | hubspot | notion | slack | sheets. Only that adapter's vars below are needed.

MONDAY_API_KEY=                      # monday.com → avatar → Developers → My access tokens
MONDAY_BOARD_ID=                     # the number in the board URL
HUBSPOT_ACCESS_TOKEN=                # HubSpot → Settings → Integrations → Private Apps (scopes: crm.objects.*.write/read)
HUBSPOT_OBJECT=contacts              # contacts | companies | deals | custom object type id
NOTION_API_KEY=                      # notion.so/my-integrations → internal integration secret; share the database with it
NOTION_DATABASE_ID=                  # 32-hex id from the database URL
SLACK_BOT_TOKEN=                     # api.slack.com/apps → OAuth & Permissions → Bot token (scope chat:write); invite the bot to the channel
SLACK_CHANNEL=                       # channel id (C…) or #name
GOOGLE_SERVICE_ACCOUNT_JSON=         # contents of the service-account key file, as one line; share the sheet with its client_email
GOOGLE_SHEET_ID=                     # the long id in the sheet URL
GOOGLE_SHEET_TAB=Sheet1              # tab name; row 1 must hold the column headers

# ---------------------------------------------------------------------------
# Supabase (single shared project, RLS-isolated per client_id)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=                # service role — admin operations, bypasses RLS
SUPABASE_ANON_KEY=                   # anon — for client SDK in admin/portal (Phase 3+)
SUPABASE_DB_URL=                     # direct Postgres URL for asyncpg pool (recommended)

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=                   # primary LLM for qualification + KB responses
OPENAI_API_KEY=                      # optional fallback / cheap-tier

# ---------------------------------------------------------------------------
# Twilio (SMS for LLR)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Email (transactional)
# ---------------------------------------------------------------------------
RESEND_API_KEY=                      # primary transport for digests + alerts
NOTIFY_FROM_EMAIL=hello@traceflow.app

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
ADMIN_JWT_SECRET=                    # signs admin session JWTs issued by POST /api/admin/login (>=32 random bytes); the bare secret is NOT a valid bearer token (ADR-0004)
ALLOWED_ORIGINS=http://localhost:5173,https://app.traceflow.app
ALLOWED_HOSTS=                        # empty = TrustedHost check OFF. Set before serving on the custom domain, e.g. "app.traceflow.app,*.onrender.com". localhost/testserver are auto-appended.
DEMO_MODE=false                      # when true, serves a public no-login, READ-ONLY copy of the admin UI at /demo backed by in-memory fixtures (no DB access). Web service ONLY — never set on the cron services.

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=                          # optional; if set, errors get reported

# ---------------------------------------------------------------------------
# Per-client integration credentials (Monday, Shopify, etc.) live in
# client_configs.crm_credentials JSONB — they are NEVER global env vars.
# See migrations/001_create_clients_and_configs.sql for the schema.
# ---------------------------------------------------------------------------
