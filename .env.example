# SIA Kit — environment for ONE client deployment.
#
# Copy to .env for local dev (.env is gitignored). On Render, set these in the
# `sia-kit-secrets` environment group. Variables marked REQUIRED stop the
# service from starting when missing — that is deliberate (fail closed).

# ============================================================================
# 1. Required for every deployment
# ============================================================================

# Direct Postgres connection string for the asyncpg pool.
# Supabase: Project → Connect → Session pooler (or Direct, port 5432) — use the
# URI form, replace [YOUR-PASSWORD]. The events table lives here.
SUPABASE_DB_URL=

# Shopify webhook signing secret. Shopify admin → Settings → Notifications →
# Webhooks → the value under "All your webhooks will be signed with ..." at the
# bottom of the page. Same secret for every webhook on that store.
SHOPIFY_WEBHOOK_SECRET=

# Which adapter receives every event. Must match `destination:` in mapping.yaml.
#   monday | hubspot | notion | slack | sheets
DESTINATION=

# Bearer token for GET /events and POST /events/{id}/replay.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# ============================================================================
# 2. Destination credentials — fill in ONLY the block for your DESTINATION
# ============================================================================

# --- notion -----------------------------------------------------------------
# notion.so/my-integrations → New integration → copy the Internal Integration
# Secret. Then open the database in Notion → ··· → Connections → add the
# integration (it cannot see the database until you do).
NOTION_API_KEY=
# 32-hex id from the database URL: notion.so/<workspace>/<THIS-PART>?v=...
NOTION_DATABASE_ID=

# --- monday -----------------------------------------------------------------
# monday.com → click your avatar → Developers → My access tokens → Show.
MONDAY_API_KEY=
# The number in the board URL: monday.com/boards/<THIS-NUMBER>
MONDAY_BOARD_ID=

# --- hubspot ----------------------------------------------------------------
# HubSpot → Settings → Integrations → Private Apps → Create → scopes
# crm.objects.contacts.read + .write (or the object you target) → Access token.
HUBSPOT_ACCESS_TOKEN=
# contacts | companies | deals | a custom object type id. Default: contacts.
HUBSPOT_OBJECT=contacts

# --- slack ------------------------------------------------------------------
# api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token
# (xoxb-…). Needs scope chat:write. Then /invite the bot to the channel.
SLACK_BOT_TOKEN=
# Channel id (C0123…, from channel details) or #name.
SLACK_CHANNEL=

# --- sheets -----------------------------------------------------------------
# Google Cloud → IAM → Service Accounts → create → Keys → Add key (JSON).
# Paste the whole file's contents on one line. Enable the Google Sheets API on
# the project. Share the spreadsheet with the service account's client_email
# as Editor. Row 1 of the tab must contain the column headers.
GOOGLE_SERVICE_ACCOUNT_JSON=
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<THIS-PART>/edit
GOOGLE_SHEET_ID=
# Tab name. Default: Sheet1
GOOGLE_SHEET_TAB=Sheet1

# ============================================================================
# 3. Strongly recommended
# ============================================================================

# Slack incoming webhook that receives one message per dead-lettered event.
# api.slack.com/apps → your app → Incoming Webhooks → Add New Webhook to
# Workspace. Without this, dead letters are only visible in logs and /health.
ALERT_WEBHOOK_URL=

# Public URL of this service; used to build the triage/replay links in alerts.
BASE_URL=https://<service>.onrender.com

# ============================================================================
# 4. Optional
# ============================================================================

ENVIRONMENT=development              # development | production (Render sets production)
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                      # json (one line per event transition) | text (local dev)
ALLOWED_HOSTS=                       # comma-separated Host allow-list, e.g. "*.onrender.com". Empty = off.
SENTRY_DSN=                          # error reporting, if you use Sentry
MAPPING_PATH=                        # only to point at a different mapping file; default mapping.yaml
